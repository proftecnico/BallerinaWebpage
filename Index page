          <img src="https://images.unsplash.com/photo-1518611012118-696072b81b6a?w=1200" alt="Danza Árabe" class="w-full h-96 md:h-screen object-cover flex-shrink-0">
          <img src="https://images.unsplash.com/photo-1551934305-b2dc352c0e83?w=1200" alt="Jazz Lyrical" class="w-full h-96 md:h-screen object-cover flex-shrink-0">
          <img src="https://images.unsplash.com/photo-1581595220364-2fd5e74e9af9?w=1200" alt="Contemporáneo" class="w-full h-96 md:h-screen object-cover flex-shrink-0">
          <img src="https://images.unsplash.com/photo-1574702581818-3c2ea44b2f49?w=1200" alt="Niñas bailando" class="w-full h-96 md:h-screen object-cover flex-shrink-0">
